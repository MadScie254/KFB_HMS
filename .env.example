# Copy to .env only for local use. Never commit real secrets.
KFB_ENV=production
KFB_SECRET_KEY=replace-with-a-long-random-secret
KFB_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.20
KFB_CSRF_TRUSTED_ORIGINS=https://hospital.example.internal
KFB_TIME_ZONE=Africa/Nairobi

# Production PostgreSQL. Leave KFB_DATABASE_URL empty only for a local demo.
KFB_DATABASE_URL=postgresql://kfb_app:replace-me@127.0.0.1:5432/kfb_hms

# Security toggles for a configured HTTPS deployment.
KFB_SECURE_SSL_REDIRECT=1
KFB_SESSION_COOKIE_SECURE=1
KFB_CSRF_COOKIE_SECURE=1

# Manual is the honest default. Live M-PESA remains disabled until configured.
KFB_MPESA_MODE=manual
KFB_MPESA_CONSUMER_KEY=
KFB_MPESA_CONSUMER_SECRET=
KFB_MPESA_SHORTCODE=
KFB_MPESA_PASSKEY=
KFB_MPESA_CALLBACK_BASE_URL=

# Backup encryption is deliberately not given a fake key.
KFB_BACKUP_DIRECTORY=D:\\KFB-HMS-Backups
KFB_BACKUP_ENCRYPTION_RECIPIENT=
KFB_BACKUP_RETENTION_DAYS=30

